<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>OEHS</AssemblyName>
    <RootNamespace>OzelEgitimHakedis.Wpf</RootNamespace>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>Assets/tehys.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Taşımalı Eğitim Hakediş Yönetim Sistemi (TEHYS)</Product>
    <Description>Özel Eğitim ve Temel Eğitim taşıma hakedişleri</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OzelEgitimHakedis.Core\OzelEgitimHakedis.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../OzelEgitimHakedis.Documents/OzelEgitimHakedis.Documents.csproj" />
  </ItemGroup>
</Project>
